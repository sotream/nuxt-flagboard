# Copy to .env (`cp .env.example .env`). Every value here is a local-development placeholder, not a secret.
# Docker Compose and the API both read this file. The API refuses to start with these values when
# APP_ENV=prod.

# --- Postgres (docker compose) ---
# Superuser that only bootstraps the database and the two roles below.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=flagboard
# 5432 is often taken by another local Postgres; change this if the port is busy.
POSTGRES_PORT=5434
# The init script also creates <POSTGRES_DB>_test for the API e2e tests.
# Passwords for the two application roles (see infra/postgres/init-roles.sql).
FLAGBOARD_MIGRATOR_PASSWORD=change-me-local-only-migrator
FLAGBOARD_APP_PASSWORD=change-me-local-only-app

# --- API ---
# Required, no default. dev | prod. prod refuses example values and a non-https WEB_ORIGIN.
APP_ENV=dev
PORT=4000
# The browser origin of the web app. Cookie endpoints accept requests from this origin only.
WEB_ORIGIN=http://localhost:3000
# The API connects as flagboard_app (data access only). Keep host and port in line with POSTGRES_PORT.
DATABASE_URL=postgres://flagboard_app:change-me-local-only-app@localhost:5434/flagboard
LOG_LEVEL=info

# Used only by the migration CLI (`pnpm db:migrate`), never by the running API. Connects as flagboard_migrator.
MIGRATOR_DATABASE_URL=postgres://flagboard_migrator:change-me-local-only-migrator@localhost:5434/flagboard
