# Rendered at image build (CSP) and at container start (API_UPSTREAM, by the official image's envsubst step).
server {
  listen 8080;
  server_name _;
  server_tokens off;
  # The listen port is the container's own (8080). Without this, the redirect nginx sends for a directory such as
  # /login names that port and breaks behind any port mapping or reverse proxy.
  absolute_redirect off;
  root /usr/share/nginx/html;

  # Set once here. Locations below must not call add_header: nginx would then drop these.
  add_header Content-Security-Policy "__CSP__" always;
  add_header X-Content-Type-Options "nosniff" always;
  add_header Referrer-Policy "no-referrer" always;

  gzip on;
  gzip_types text/css application/javascript application/json image/svg+xml;

  # The admin API. Also carries the live-update stream (Server-Sent Events), which must not be buffered and
  # stays open for a long time: without these two lines the browser would see events late or the proxy would cut
  # an idle stream.
  location /api/ {
    proxy_pass ${API_UPSTREAM};
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Connection "";
    proxy_buffering off;
    proxy_read_timeout 1h;
  }

  # The public API for SDKs. Ordinary short requests, so default buffering and timeouts.
  location /v1/ {
    proxy_pass ${API_UPSTREAM};
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Connection "";
  }

  # File names under _nuxt carry a content hash, so they never change.
  location /_nuxt/ {
    expires max;
    try_files $uri =404;
  }

  # Fonts keep their file names, so they get a long but finite lifetime. A missing font is a 404, never the app shell.
  location /fonts/ {
    expires 30d;
    try_files $uri =404;
  }

  # A single-page app: every other path is a client route, answered with the app shell.
  location / {
    expires -1;
    try_files $uri $uri/ /200.html;
  }
}
